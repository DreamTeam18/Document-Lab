# Copy to .env and supply credentials locally. Never commit .env.
DATABASE_URL=postgresql://USER:YOUR_DATABASE_PASSWORD@localhost:5432/rag_clone
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ALLOW_PAID_MODELS=false
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=768
VECTOR_BACKEND=pinecone
PINECONE_KEY=
PINECONE_INDEX=agentic-rag
PINECONE_NAMESPACE=rag-clone
WEB_FRONTEND_URL=http://localhost:3001

# Per-request research bounds (shared across recovery attempts)
MAX_SUB_QUESTIONS=2
CHAT_CALL_LIMIT=6
EMBEDDING_CALL_LIMIT=13

# Experimental query-side HyDE; evaluate before enabling
HYDE_ENABLED=false

# Bounded research concurrency per request and per backend process
RESEARCH_CONCURRENCY=2
RESEARCH_SERVICE_CONCURRENCY=2

# Optional public web research; automatic fallback when document evidence is insufficient
TAVILY_KEY=
# Optional authoritative publishers as a JSON list, e.g. ["docs.python.org"]
TAVILY_INCLUDE_DOMAINS=[]
