# Copy to .env and supply credentials locally. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rag_clone
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ALLOW_PAID_MODELS=false
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=768
VECTOR_BACKEND=pinecone
PINECONE_KEY=
PINECONE_INDEX=agentic-rag
PINECONE_NAMESPACE=rag-clone
WEB_FRONTEND_URL=http://localhost:3001
